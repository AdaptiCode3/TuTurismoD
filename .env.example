# Configuración de Servidor y Entorno
DEBUG=False
PORT=8000
SECRET_KEY=tu_clave_secreta_jwt_para_desarrollo_o_produccion_64_caracteres
ALLOWED_HOSTS=localhost,127.0.0.1,tu-backend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://tu-frontend.onrender.com

# Configuración de Base de Datos (MongoDB Atlas o Local)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_DB_NAME=tuturismo_db

# Configuración de Correo Electrónico (Resend.com)
# Regístrate en https://resend.com y genera tu API Key en la sección API Keys (empezará con re_...)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_123456789abcdef_ejemplo_api_key
DEFAULT_FROM_EMAIL=Tu-Turismo <onboarding@resend.dev>

# Configuración de Almacenamiento de Imágenes en la Nube (Cloudinary)
# Regístrate/Ingresa en https://console.cloudinary.com/ y copia tus credenciales del Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key_numerica
CLOUDINARY_API_SECRET=tu_api_secret_alfanumerica
