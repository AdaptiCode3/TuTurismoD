# Configuración de Servidor y Entorno
DEBUG=True
PORT=8000
SECRET_KEY=tu_clave_secreta_jwt_para_desarrollo

# Configuración de Base de Datos (MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=tuturismo_db

# Configuración de Correo Electrónico (Resend recomendado para producción)
# Regístrate gratis en https://resend.com y genera tu API Key (re_...)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_123456789abcdef_ejemplo_api_key
DEFAULT_FROM_EMAIL=Tu-Turismo <onboarding@resend.dev>
